# Build stage
FROM node:lts-alpine AS build
WORKDIR /app
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
ARG VITE_API_BASE_URL
ARG VITE_GIGYA_API_KEY
ARG VITE_GIGYA_BASE_URL
ARG VITE_NETTO_AUTHORIZE_URL
ARG VITE_NETTO_CLIENT_ID
ARG VITE_NETTO_REDIRECT_URI
ARG VITE_NETTO_TENANT_ID
ARG VITE_NETTO_CHANNEL
ARG VITE_NETTO_CLIENT_FLOW
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID
ENV VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GIGYA_API_KEY=$VITE_GIGYA_API_KEY
ENV VITE_GIGYA_BASE_URL=$VITE_GIGYA_BASE_URL
ENV VITE_NETTO_AUTHORIZE_URL=$VITE_NETTO_AUTHORIZE_URL
ENV VITE_NETTO_CLIENT_ID=$VITE_NETTO_CLIENT_ID
ENV VITE_NETTO_REDIRECT_URI=$VITE_NETTO_REDIRECT_URI
ENV VITE_NETTO_TENANT_ID=$VITE_NETTO_TENANT_ID
ENV VITE_NETTO_CHANNEL=$VITE_NETTO_CHANNEL
ENV VITE_NETTO_CLIENT_FLOW=$VITE_NETTO_CLIENT_FLOW
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Serve stage
FROM nginx:alpine AS final
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
